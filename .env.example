# Copy to `.env` and fill in. `.env` is gitignored and is never committed.
#   cp .env.example .env
#
# The Anthropic key. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# The SEC requires a descriptive User-Agent with a contact address for EDGAR.
EDGAR_USER_AGENT=credit-brief your-email@example.com
